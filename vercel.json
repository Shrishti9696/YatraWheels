{
  "buildCommand": "pnpm --filter @workspace/yatrawheels run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/yatrawheels/dist/public",
  "framework": "vite",
  "regions": ["iad1"],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
